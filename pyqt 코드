    return result


def main_page(window=None):
    global widgets

    if window is None:
        window = QWidget()
        window.setFixedSize(1000,600)

    delete_widgets()

    loop = QEventLoop()
    result = None

    getstarted_button = QPushButton("시작하기", window)
    widgets.append(getstarted_button)

    getstarted_button.setFixedSize(250,125)
    getstarted_button.move(centerX(250),centerY(125))
    getstarted_button.show()

    quit_button = QPushButton("끄기", window)
    widgets.append(quit_button)

    quit_button.setFixedSize(150,75)
    quit_button.move(850,0)
    quit_button.show()

    def go_started():
        nonlocal result
        result = "started"
        loop.quit()

    getstarted_button.clicked.connect(go_started)
    quit_button.clicked.connect(sys.exit)

    window.show()

    loop.exec()
    return window, result


if __name__ == "__main__":
    window = None
    page = "main"

    while True:
        if page == "main":
            window, page = main_page(window)

        elif page == "started":
            page = started_page(window)
        
        elif page == "add_schedule":
            page = add_schedule_page(window)

        elif page == "see_schedule":
            page = see_schedule_page(window)
        
        elif page == "quit":
            break

    sys.exit()
