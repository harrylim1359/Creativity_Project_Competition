def started_page(window):
    global widgets

    delete_widgets()

    loop = QEventLoop()
    result = None

    add_plan_button = QPushButton("일정 추가하기", window)
    widgets.append(add_plan_button)
    add_plan_button.setFixedSize(250,125)
    add_plan_button.move(centerX(250),centerY(125)-70)
    add_plan_button.show()
    
    see_plan_button = QPushButton("일정 확인하기", window)
    widgets.append(see_plan_button)
    see_plan_button.setFixedSize(250,125)
    see_plan_button.move(centerX(250),centerY(125)+70)
    see_plan_button.show()

    return_button = QPushButton("돌아가기", window)
    widgets.append(return_button)
    return_button.setFixedSize(150,75)
    return_button.move(850,0)
    return_button.show()

    def go_main():
        nonlocal result
        result = "main"
        loop.quit()
    
    def go_see_schedule():
        nonlocal result
        result  = "see_schedule"
        loop.quit()
    
    def go_add_schedule():
        nonlocal result
